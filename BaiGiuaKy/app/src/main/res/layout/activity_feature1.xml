<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tinh chu vi va dien tich"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/edtDai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhap chieu dai (m)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/edtRong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhap chieu rong (m)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnTinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ket qua"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvKetQua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E8F5E9"/>

</LinearLayout>